######## TBATS
tbats_estimator2 <- TBATSEstimator$new(data = data)#, x_pre_pro = TLS_regr) # GLS fails with it
results_tbats2 <- calculate_revisions_by_lags(
estimator_instance = tbats_estimator2
)
results_tbats2
save.image(file="workspace_births_in_France.RData")
