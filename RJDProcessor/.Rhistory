serie_fit <- window(y, end=anno_mese(n_end))
previsioni_tramo[j] <- round(tramo_forecast(serie_fit, spec="trfull")[h])
}
# ------------------------
# 4. Errori
# ------------------------
MAE_SSM_proxy    <- round(mean(abs(observed - pred_with_proxy)), 0)
MAE_SSM_no_proxy <- round(mean(abs(observed - pred_without_proxy)), 0)
MAE_Tramo        <- round(mean(abs(observed - previsioni_tramo)), 0)
MAPE_SSM_proxy    <- mean(abs(observed - pred_with_proxy) / abs(observed)) * 100
MAPE_SSM_no_proxy <- mean(abs(observed - pred_without_proxy) / abs(observed)) * 100
MAPE_Tramo        <- mean(abs(observed - previsioni_tramo) / abs(observed)) * 100
Diff_MAE_SSMproxy_vs_Tramo <- MAE_SSM_proxy - MAE_Tramo
Diff_MAE_SSMproxy_vs_SSMno <- MAE_SSM_proxy - MAE_SSM_no_proxy
# ------------------------
# 4.bis. Calcolo MAE e MAPE per MNO non scaled
# ------------------------
MAE_MNO <- round(mean(abs(observed - window(x, end = time(y)[T_total])[1:n_forecast])), 0)
MAPE_MNO <- mean(abs(observed - window(x, end = time(y)[T_total])[1:n_forecast]) / abs(observed)) * 100
# ------------------------
# 4ter. Ri-calcolo scaled MNO (rolling, solo per confronto)
# ------------------------
scaled_MNO_vec <- numeric(n_forecast)
for(j in 1:n_forecast){
t <- t_start + j - 1
y_train <- window(y, end = time(y)[t-1])
if(time(y)[t-1] >= time(x)[1]){
x_train_raw <- window(x, end = time(y)[t-1])
scaled_MNO_vec[j] <- adjust_proxy(y_train, x_train_raw)[length(x_train_raw)]
} else {
scaled_MNO_vec[j] <- NA
}
}
MAE_MNO_scaled  <- round(mean(abs(observed - scaled_MNO_vec), na.rm = TRUE), 0)
MAPE_MNO_scaled <- mean(abs(observed - scaled_MNO_vec) / abs(observed), na.rm = TRUE) * 100
# ------------------------
summary_results <- rbind(summary_results, data.frame(
PROVINCE = current_province,
MAE_SSM_no_proxy = MAE_SSM_no_proxy,
MAE_SSM_proxy    = MAE_SSM_proxy,
MAE_Tramo        = MAE_Tramo,
MAE_MNO_scaled   = MAE_MNO_scaled,
MAPE_SSM_no_proxy = MAPE_SSM_no_proxy,
MAPE_SSM_proxy    = MAPE_SSM_proxy,
MAPE_Tramo        = MAPE_Tramo,
MAPE_MNO_scaled   = MAPE_MNO_scaled,
MAE_MNO  = MAE_MNO,
MAPE_MNO = MAPE_MNO,
Diff_MAE_SSMproxy_vs_Tramo = Diff_MAE_SSMproxy_vs_Tramo,
Diff_MAE_SSMproxy_vs_SSMno = Diff_MAE_SSMproxy_vs_SSMno
))
# ------------------------
# 5. Plot
# ------------------------
dates <- as.Date(df$DATE[(length(y)-n_forecast+1):length(y)])
df_plot <- data.frame(
DATE = dates,
Observed = as.numeric(observed),
SSM_no_proxy = pred_without_proxy,
SSM_proxy = pred_with_proxy,
Tramo = previsioni_tramo
)
p <- ggplot(df_plot, aes(x = DATE)) +
geom_line(aes(y = Observed, colour = "Observed"), size = 1) +
geom_line(aes(y = SSM_no_proxy, colour = "SSM no proxy"), size = 1, linetype = "dashed") +
geom_line(aes(y = SSM_proxy, colour = "SSM proxy"), size = 1, linetype = "dotdash") +
geom_line(aes(y = Tramo, colour = "Tramo"), size = 1, linetype = "twodash") +
scale_colour_manual(
values = c("Observed"="black",
"SSM no proxy"="blue",
"SSM proxy"="red",
"Tramo"="green"),
breaks = c("Observed", "SSM no proxy", "SSM proxy", "Tramo")
) +
labs(title = paste("Forecast comparison for", current_province),
x = "Date", y = "Value", colour = "") +
theme_minimal() +
theme(legend.position = "bottom")
all_plots[[current_province]] <- p
}
# ------------------------
# 6. Salvataggio risultati
# ------------------------
output_file <- "C:\\Users\\UTENTE\\OneDrive - ISTAT\\Desktop\\MNO_dec_2025\\forecast_summary.xlsx"
write.xlsx(summary_results, output_file, rowNames = FALSE)
print(summary_results)
# ------------------------
# 7. Stampa tutti i plot
# ------------------------
for(plot_name in names(all_plots)) {
print(all_plots[[plot_name]])
}
##########################
#        Plots           #
##########################
# ==========================
# 1. Read shapefile
# ==========================
shp_path <- "C:\\Users\\UTENTE\\OneDrive - ISTAT\\Desktop\\MNO_dec_2025\\Limiti01012023_g/ProvCM01012023_g/ProvCM01012023_g_WGS84.shp"
prov_shp <- st_read(shp_path)
# ==========================
# 2. Filter only Emilia-Romagna
# ==========================
prov_emr <- prov_shp %>% filter(COD_REG == 8)
# ==========================
# 3. Compute MAE difference (SSM_proxy vs best of SSM_no_proxy, Tramo)
# ==========================
mae_diff <- summary_results %>%
rowwise() %>%
mutate(
Best_MAE = min(MAE_SSM_no_proxy, MAE_Tramo),
Diff_MAE = MAE_SSM_proxy - Best_MAE
) %>%
ungroup() %>%
select(PROVINCE, MAE_SSM_proxy, Best_MAE, Diff_MAE)
# ==========================
# 4. Standardize province names
# ==========================
mae_diff <- mae_diff %>%
mutate(PROVINCE = case_when(
PROVINCE == "REGGIO_EMILIA" ~ "Reggio Nell'emilia",
PROVINCE == "FORLI-CESENA" ~ "Forli'-Cesena",
TRUE ~ str_to_title(PROVINCE)
))
# ==========================
# 5. Join shapefile with MAE data
# ==========================
prov_emr <- prov_emr %>%
mutate(PROVINCIA = str_to_title(DEN_UTS)) %>%
left_join(mae_diff, by = c("PROVINCIA" = "PROVINCE"))
# ==========================
# 6. Map
# ==========================
prov_emr$Diff_MAE[1] <- prov_emr$Diff_MAE[1] - 1700 # enfatizzo il verde di Piacenza
ggplot(prov_emr) +
geom_sf(aes(fill = Diff_MAE), color = "black") +
scale_fill_gradient2(
low = "green", mid = "white", high = "#FF9999",
midpoint = 0,
name = "MAE difference\n(SSM proxy - best model)"
) +
theme_minimal() +
labs(
title = "MAE comparison: SSM with proxy vs best model (Tramo or SSM without proxy)",
subtitle = "Green = Proxy better, Red = Proxy worse",
caption = "Data: Official statistics and MNO estimates"
)
library(KFAS)
library(readxl)
library(lubridate)
library(openxlsx)
library(ggplot2)
library(rjd3tramoseats)
library(dplyr)
library(ggplot2)
library(sf)
library(stringr)
# ------------------------
# 1. Dati reali
# ------------------------
file_input <- "C:\\Users\\UTENTE\\OneDrive - ISTAT\\Desktop\\MNO_dec_2025\\input_data_provinces.xlsx"
df <- read_excel(file_input, sheet = 1)
colnames(df)[1] <- "DATE"
start_anno_official_stat <- 2016
start_mese_official_stat <- 1
start_anno_MNO <- 2022
start_mese_MNO <- 8
n_forecast <- 6
provinces_cols <- c("TOT","BOLOGNA","REGGIO_EMILIA","MODENA","PARMA",
"PIACENZA","FERRARA","FORLI-CESENA","RAVENNA","RIMINI")
MNO_cols <- c("TOT_MNO","BOLOGNA_MNO","REGGIO_EMILIA_MNO","MODENA_MNO",
"PARMA_MNO","PIACENZA_MNO","FERRARA_MNO","FORLI-CESENA_MNO",
"RAVENNA_MNO","RIMINI_MNO")
# Funzione di scaling: fattore medio semplice
adjust_proxy <- function(y_train, x_train) {
ratio <- y_train / x_train
factor <- mean(ratio[is.finite(ratio)], na.rm = TRUE)
# return(x_train * factor)
# return(x_train * 1)
}
# Funzione utilità per date da indice numerico
anno_mese <- function(i) {
anno <- start_anno_official_stat + (i-1) %/% 12
mese <- 1 + (i-1) %% 12
return(c(anno,mese))
}
# Contenitori risultati
summary_results <- data.frame()
all_plots <- list()
for(i in 1:length(provinces_cols)) {
current_province <- provinces_cols[[i]]
current_MNO      <- MNO_cols[[i]]
TOT     <- df[[current_province]]
TOT_MNO <- df[[current_MNO]]
x_vec <- suppressWarnings(as.numeric(as.vector(t(TOT_MNO))))
x_vec <- x_vec[((start_anno_MNO - start_anno_official_stat)*12 + start_mese_MNO):length(x_vec)]
x <- ts(x_vec, start = c(start_anno_MNO, start_mese_MNO), frequency = 12)
y <- ts(TOT, start = c(start_anno_official_stat, start_mese_official_stat), frequency = 12)
# ------------------------
# 2. Rolling forecast one-step ahead con SSM
# ------------------------
T_total <- length(y)
t_start <- T_total - n_forecast + 1
pred_with_proxy <- numeric(n_forecast)
pred_without_proxy <- numeric(n_forecast)
observed <- y[t_start:T_total]
for(j in 1:n_forecast){
t <- t_start + j - 1
y_train <- window(y, end = time(y)[t-1])
x_train <- NULL
if(time(y)[t-1] >= time(x)[1]){
x_train_raw <- window(x, end = time(y)[t-1])
x_train <- adjust_proxy(y_train, x_train_raw) # Alla fine fra aggiustare e non aggiustare non cambia nulla nelle previsioni (lascio così per avere i dati aggiustati per la tabella degli scaled)
}
# --- Modello con proxy ---
if(!is.null(x_train)){
obs_matrix <- cbind(y_train, x_train)
model_proxy <- SSModel(obs_matrix ~
SSMtrend(1, Q = diag(1,2)) +
SSMseasonal(12, Q = diag(0.1,2)),
H = diag(0.01,2))
} else {
model_proxy <- SSModel(y_train ~ SSMtrend(1, Q = NA) + SSMseasonal(12, Q = NA), H = NA)
}
fit_proxy <- suppressWarnings(
fitSSM(model_proxy,
inits = rep(1, length(model_proxy$H) + sum(sapply(model_proxy$Q, length))),
method = "BFGS", control = list(reltol = 1e-10))
)
fitted_model_proxy <- fit_proxy$model
pred <- suppressWarnings(predict(fitted_model_proxy, n.ahead = 1, type = "response"))
pred_with_proxy[j] <- as.numeric(pred[1])
# --- Modello senza proxy ---
model_no_proxy <- SSModel(y_train ~ SSMtrend(1, Q = NA) + SSMseasonal(12, Q = NA), H = NA)
fit_no_proxy <- suppressWarnings(
fitSSM(model_no_proxy,
inits = rep(1, length(model_no_proxy$H) + sum(sapply(model_no_proxy$Q, length))),
method = "BFGS", control = list(reltol = 1e-10))
)
fitted_model_no_proxy <- fit_no_proxy$model
pred_no <- suppressWarnings(predict(fitted_model_no_proxy, n.ahead = 1, type = "response"))
pred_without_proxy[j] <- as.numeric(pred_no[1])
}
# ------------------------
# 3. Rolling forecast con TRAMO (Scenario 1)
# ------------------------
n_end_init <- T_total - n_forecast
h <- 1
previsioni_tramo <- numeric(n_forecast)
for(j in 1:n_forecast){
n_end <- n_end_init + j - 1
serie_fit <- window(y, end=anno_mese(n_end))
previsioni_tramo[j] <- round(tramo_forecast(serie_fit, spec="trfull")[h])
}
# ------------------------
# 4. Errori
# ------------------------
MAE_SSM_proxy    <- round(mean(abs(observed - pred_with_proxy)), 0)
MAE_SSM_no_proxy <- round(mean(abs(observed - pred_without_proxy)), 0)
MAE_Tramo        <- round(mean(abs(observed - previsioni_tramo)), 0)
MAPE_SSM_proxy    <- mean(abs(observed - pred_with_proxy) / abs(observed)) * 100
MAPE_SSM_no_proxy <- mean(abs(observed - pred_without_proxy) / abs(observed)) * 100
MAPE_Tramo        <- mean(abs(observed - previsioni_tramo) / abs(observed)) * 100
Diff_MAE_SSMproxy_vs_Tramo <- MAE_SSM_proxy - MAE_Tramo
Diff_MAE_SSMproxy_vs_SSMno <- MAE_SSM_proxy - MAE_SSM_no_proxy
# ------------------------
# 4.bis. Calcolo MAE e MAPE per MNO non scaled
# ------------------------
MAE_MNO <- round(mean(abs(observed - window(x, end = time(y)[T_total])[1:n_forecast])), 0)
MAPE_MNO <- mean(abs(observed - window(x, end = time(y)[T_total])[1:n_forecast]) / abs(observed)) * 100
# ------------------------
# 4ter. Ri-calcolo scaled MNO (rolling, solo per confronto)
# ------------------------
scaled_MNO_vec <- numeric(n_forecast)
for(j in 1:n_forecast){
t <- t_start + j - 1
y_train <- window(y, end = time(y)[t-1])
if(time(y)[t-1] >= time(x)[1]){
x_train_raw <- window(x, end = time(y)[t-1])
scaled_MNO_vec[j] <- adjust_proxy(y_train, x_train_raw)[length(x_train_raw)]
} else {
scaled_MNO_vec[j] <- NA
}
}
MAE_MNO_scaled  <- round(mean(abs(observed - scaled_MNO_vec), na.rm = TRUE), 0)
MAPE_MNO_scaled <- mean(abs(observed - scaled_MNO_vec) / abs(observed), na.rm = TRUE) * 100
# ------------------------
summary_results <- rbind(summary_results, data.frame(
PROVINCE = current_province,
MAE_SSM_no_proxy = MAE_SSM_no_proxy,
MAE_SSM_proxy    = MAE_SSM_proxy,
MAE_Tramo        = MAE_Tramo,
MAE_MNO_scaled   = MAE_MNO_scaled,
MAPE_SSM_no_proxy = MAPE_SSM_no_proxy,
MAPE_SSM_proxy    = MAPE_SSM_proxy,
MAPE_Tramo        = MAPE_Tramo,
MAPE_MNO_scaled   = MAPE_MNO_scaled,
MAE_MNO  = MAE_MNO,
MAPE_MNO = MAPE_MNO,
Diff_MAE_SSMproxy_vs_Tramo = Diff_MAE_SSMproxy_vs_Tramo,
Diff_MAE_SSMproxy_vs_SSMno = Diff_MAE_SSMproxy_vs_SSMno
))
# ------------------------
# 5. Plot
# ------------------------
dates <- as.Date(df$DATE[(length(y)-n_forecast+1):length(y)])
df_plot <- data.frame(
DATE = dates,
Observed = as.numeric(observed),
SSM_no_proxy = pred_without_proxy,
SSM_proxy = pred_with_proxy,
Tramo = previsioni_tramo
)
p <- ggplot(df_plot, aes(x = DATE)) +
geom_line(aes(y = Observed, colour = "Observed"), size = 1) +
geom_line(aes(y = SSM_no_proxy, colour = "SSM no proxy"), size = 1, linetype = "dashed") +
geom_line(aes(y = SSM_proxy, colour = "SSM proxy"), size = 1, linetype = "dotdash") +
geom_line(aes(y = Tramo, colour = "Tramo"), size = 1, linetype = "twodash") +
scale_colour_manual(
values = c("Observed"="black",
"SSM no proxy"="blue",
"SSM proxy"="red",
"Tramo"="green"),
breaks = c("Observed", "SSM no proxy", "SSM proxy", "Tramo")
) +
labs(title = paste("Forecast comparison for", current_province),
x = "Date", y = "Value", colour = "") +
theme_minimal() +
theme(legend.position = "bottom")
all_plots[[current_province]] <- p
}
# ------------------------
# 6. Salvataggio risultati
# ------------------------
output_file <- "C:\\Users\\UTENTE\\OneDrive - ISTAT\\Desktop\\MNO_dec_2025\\forecast_summary.xlsx"
write.xlsx(summary_results, output_file, rowNames = FALSE)
print(summary_results)
# ------------------------
# 7. Stampa tutti i plot
# ------------------------
for(plot_name in names(all_plots)) {
print(all_plots[[plot_name]])
}
